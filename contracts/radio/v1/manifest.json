{
  "protocol": "duoplus.radio",
  "protocolVersion": 1,
  "description": "Shared radio-plugin protocol fixtures. Both the controller and the plugin APK must produce the stated outcome for every case.",
  "outcomes": {
    "ACCEPT": "The validator must accept the message.",
    "REJECT": "The validator must refuse the message with the stated code, and with the stated detail when present."
  },
  "cases": [
    {
      "file": "fixtures/apply-moving-valid.json",
      "messageType": "radio.apply",
      "expect": "ACCEPT",
      "code": null,
      "detail": null,
      "why": "Drive frame: Wi-Fi from a 30 s cached scan, per-tick cells, Bluetooth held."
    },
    {
      "file": "fixtures/apply-arrival-valid.json",
      "messageType": "radio.apply",
      "expect": "ACCEPT",
      "code": null,
      "detail": null,
      "why": "Arrival frame: the only phase permitted to replace Bluetooth."
    },
    {
      "file": "fixtures/apply-empty-replace-valid.json",
      "messageType": "radio.apply",
      "expect": "ACCEPT",
      "code": null,
      "detail": null,
      "why": "REPLACE with an empty list asserts nothing is present; it is not missing data."
    },
    {
      "file": "fixtures/apply-cleanup-clear-valid.json",
      "messageType": "radio.apply",
      "expect": "ACCEPT",
      "code": null,
      "detail": null,
      "why": "Cleanup explicitly clears the controller-injected state on every interface."
    },
    {
      "file": "fixtures/apply-hold-all-valid.json",
      "messageType": "radio.apply",
      "expect": "ACCEPT",
      "code": null,
      "detail": null,
      "why": "Every interface held: the phone keeps whatever it already has."
    },
    {
      "file": "fixtures/apply-future-protocol-version.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "PROTOCOL_VERSION_UNSUPPORTED",
      "detail": "PROTOCOL_VERSION",
      "why": "A newer protocol version is refused outright rather than partially interpreted."
    },
    {
      "file": "fixtures/apply-unknown-protocol.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "PROTOCOL_VERSION_UNSUPPORTED",
      "detail": "PROTOCOL_NAME",
      "why": "A different protocol name is refused before any field is read."
    },
    {
      "file": "fixtures/apply-unknown-message-type.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MESSAGE_TYPE_UNSUPPORTED",
      "detail": null,
      "why": "An unrecognized message type is never guessed at."
    },
    {
      "file": "fixtures/apply-hold-with-entries.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "HOLD must carry no payload; a hold that ships data is ambiguous."
    },
    {
      "file": "fixtures/apply-replace-null-entries.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "REPLACE must carry a list; null would be indistinguishable from a hold."
    },
    {
      "file": "fixtures/apply-clear-with-entries.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "CLEAR removes state; it cannot also assert content."
    },
    {
      "file": "fixtures/apply-unknown-directive.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "Only HOLD, REPLACE and CLEAR exist."
    },
    {
      "file": "fixtures/apply-bluetooth-replaced-in-motion.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": "BLUETOOTH_REPLACED_IN_MOTION",
      "why": "Bluetooth replacement during movement is refused by the contract, not only by the arrival gate."
    },
    {
      "file": "fixtures/apply-cleanup-applies-state.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": "CLEANUP_APPLIES_STATE",
      "why": "A cleanup frame cannot install new state on its way out."
    },
    {
      "file": "fixtures/apply-missing-boot-id.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "Boot identity is mandatory; without it a pre-reboot frame could be applied after a restart."
    },
    {
      "file": "fixtures/apply-unknown-field.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "Unknown fields are refused. Extensions arrive through capability negotiation, not silent tolerance."
    },
    {
      "file": "fixtures/apply-sample-newer-than-frame.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": "SAMPLE_AHEAD_OF_FRAME",
      "why": "A cached sample cannot be dated after the frame delivering it."
    },
    {
      "file": "fixtures/apply-negative-sim-clock.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "Simulation time is a non-negative integer in the SIM domain."
    },
    {
      "file": "fixtures/apply-validfor-too-long.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "An unbounded validity window would let a stale frame apply late."
    },
    {
      "file": "fixtures/apply-two-registered-cells.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": "MULTIPLE_SERVING_CELLS",
      "why": "A phone has one serving cell."
    },
    {
      "file": "fixtures/apply-lte-rsrp-out-of-range.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": "MEASUREMENT_OUT_OF_RANGE",
      "why": "RSRP is range-checked per radio technology: -35 dBm is plausible for NR and impossible for LTE."
    },
    {
      "file": "fixtures/apply-rsrp-outside-any-technology.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "A value no radio technology reports is refused by the field range itself."
    },
    {
      "file": "fixtures/apply-lte-identity-out-of-range.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": "IDENTITY_OUT_OF_RANGE",
      "why": "An NR-sized cell identity cannot be labeled LTE."
    },
    {
      "file": "fixtures/apply-uppercase-bssid.json",
      "messageType": "radio.apply",
      "expect": "REJECT",
      "code": "MALFORMED_MESSAGE",
      "detail": null,
      "why": "Identifiers are normalized to lowercase so comparison never depends on casing."
    },
